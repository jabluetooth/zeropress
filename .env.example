# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API auth — used by n8n to publish posts (Authorization: Bearer <value>)
API_SECRET_KEY=

# Admin panel — separate from API key
ADMIN_SECRET=

# n8n webhook — trigger-workflow route sends this as a header named
# N8N_BEARER_TOKEN (the Webhook node's Header Auth credential), not
# Authorization: Bearer
N8N_WEBHOOK_URL=
N8N_BEARER_TOKEN=

# Site metadata
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_DESCRIPTION=
